# ==============================================================================
# FacturaGas Environment Configuration Example
# ==============================================================================

# Role / Mode of this container:
# - 'web': Only starts Express HTTP server and frontend UI (Worker is disabled)
# - 'worker': Only starts BullMQ background worker (No HTTP server)
# - 'all': Starts both Web and Worker in the same container (default / monolithic)
APP_MODE=all

# HTTP Server Configuration
PORT=4000
HOST=0.0.0.0

# Redis Connection (used by BullMQ queue and History Storage)
# In Docker Compose or Easypanel, use the service hostname: e.g. redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Automation Flags
RECORD_VIDEO=false
TAKE_SCREENSHOT=true
DRY_RUN=false

# Verbose Worker & Automation Debug Logs (prints detailed step traces in stdout)
DEBUG=false
LOG_LEVEL=info

# Storage Configuration
# Driver options: 'local' | 's3' | 'minio'
STORAGE_DRIVER=local

# Local Storage Paths (used when STORAGE_DRIVER=local)
SCREENSHOT_DIR=output
VIDEO_DIR=output/videos

# S3 / MinIO Configuration (used when STORAGE_DRIVER=s3 or STORAGE_DRIVER=minio)
# For MinIO in Docker/Easypanel, use: http://minio:9000 (or http://127.0.0.1:9000 locally)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=combusticket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# Optional public URL base (e.g. if behind custom domain or CDN: https://s3.tudominio.com/combusticket):
# S3_PUBLIC_URL=

# ==============================================================================
# Web Push Notifications (VAPID)
# ==============================================================================
VAPID_PUBLIC_KEY=BBD_umeTsnRjxR0SajkbfXeuwQvy1wOfXLK2LCat0M_UOT1OEu0YEk7ifkDQe_kF68Tk8ZbaMVD19dgzCgseTus
