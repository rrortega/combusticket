{
  "name": "combusticket",
  "version": "1.0.0",
  "type": "module",
  "description": "CombusTicket - Servicio inteligente de facturación de gasolina con OCR y automatización web",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:dev": "tsx src/main.ts",
    "start:web": "APP_MODE=web node dist/src/main.js",
    "start:worker": "APP_MODE=worker node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "api": "tsx watch src/main.ts",
    "invoice": "tsx src/index.ts",
    "invoice:submit": "tsx src/index.ts --submit",
    "mcp": "node dist/src/interfaces/mcp/server.js",
    "mcp:dev": "tsx src/interfaces/mcp/server.ts",
    "generate:icons": "node scripts/generate-pwa-assets.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "multer": "^2.3.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7"
  }
}
